# Copy this to .env.local and fill in real values. Every var here is
# optional in the sense that the site still builds and runs without it —
# the feature it powers just falls back gracefully (see the relevant
# lib file's comments for the exact fallback behavior).

# Analytics (src/components/PostHogProvider.tsx)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Book cover/page-count lookups on /books (src/lib/books.ts). Without this,
# Open Library is still tried as a fallback.
GOOGLE_BOOKS_API_KEY=

# WHOOP developer app (src/lib/whoop.ts), powers the half-marathon goal's
# live running stats on /goals. From developer-dashboard.whoop.com.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Upstash Redis (free tier) — stores the WHOOP refresh token, which
# rotates on every use and so can't live in a static env var. REST URL +
# token from your Upstash database's dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canonical site origin for SEO/social cards (src/lib/seo.ts). On Vercel
# this is auto-detected — only set it for local testing of that logic.
# NEXT_PUBLIC_SITE_URL=
